# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- โมเดลเราบน Modal (Phase B, สรุปหลัก) ---
# endpoint จาก `modal deploy` + bearer token (modal.Secret)
MODAL_SUMMARIZER_URL=
MODAL_SUMMARIZER_TOKEN=

# --- Gemini (fallback ตอนโมเดลเราสรุปไม่ผ่าน) ---
GEMINI_API_KEY=

# Shared secret required to call POST /api/ingest (from /admin or manual ingest).
# If unset, the ingest route denies everything (fail closed).
INGEST_SECRET=

# Vercel Cron แนบ Authorization: Bearer <CRON_SECRET> ให้อัตโนมัติ.
# ถ้าไม่ตั้ง /api/ingest-cron จะปฏิเสธทุก request (fail closed).
CRON_SECRET=
